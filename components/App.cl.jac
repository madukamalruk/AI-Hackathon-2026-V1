sv import from ..services.api { get_app_info, plan_pathways, run_stress_test }

def rows(data: dict, key: str) -> list[dict] { return data.get(key, []) as list[dict]; }
def strings(data: dict, key: str) -> list[str] { return data.get(key, []) as list[str]; }
def label_for(value: any) -> str { return str(value).replace("_", " "); }
def money(value: any) -> str { return "Not confirmed" if value is None else "LKR " + str(value); }
def route_label(value: any) -> str {
    if value == "needs_confirmation" { return "Needs confirmation"; }
    if value == "conditional" { return "Conditional route"; }
    if value == "not_feasible_under_current_inputs" { return "Does not fit current inputs"; }
    return "Fits stated assumptions";
}
def:pub TextField(name: str, label: str, value: any, onChange: Callable[[ChangeEvent], None], kind: str = "text", hint: str = "", maxLength: int = 160, minimum: str = "0", maximum: str = "100000000", stepValue: str = "1") -> JsxElement {
    return <div className="field"><label htmlFor={name}>{label}</label><input id={name} name={name} type={kind} value={value} onChange={onChange} maxLength={maxLength} step={stepValue} min={minimum} max={maximum} aria-describedby={name + "-hint"} /><small id={name + "-hint"}>{hint}</small></div>;
}
def:pub SelectField(name: str, label: str, value: any, options: list, onChange: Callable[[ChangeEvent], None], idSuffix: str = "") -> JsxElement {
    return <div className="field"><label htmlFor={name + idSuffix}>{label}</label><select id={name + idSuffix} name={name} value={value} onChange={onChange}>{for option in options { <option key={str(option[0])} value={option[0]}>{option[1]}</option> }}</select></div>;
}
def:pub Evidence(claims: list[dict]) -> JsxElement {
    return <details className="evidence"><summary>{"Sources & claim checks (" + str(len(claims)) + ")"}</summary><p className="muted">A checked programme title does not confirm fees, entry rules or recognition. Review each claim separately.</p><ul className="claim-list">{for claim in claims { <li key={claim["id"]}><div className="row spread"><strong>{label_for(claim["field"])}</strong><span className={"status " + str(claim["status"])}>{label_for(claim["status"])}</span></div><p>{claim.get("note", "")}</p><div className="row spread"><a href={claim["source_url"]} target="_blank" rel="noopener noreferrer">Open source ↗</a><small>{"Checked " + str(claim.get("checked_on", "Not confirmed"))}</small></div></li> }}</ul></details>;
}
def:pub RouteView(route: dict, index: int) -> JsxElement {
    cash = route.get("cashflow", {}) as dict;
    return <article className="route"><div className="route-heading"><span className="route-index">{"0" + str(index + 1)}</span><div><span className={"status " + str(route.get("route_status", "needs_confirmation"))}>{route_label(route.get("route_status", "needs_confirmation"))}</span><h3>{route["title"]}</h3></div></div><p className="route-explanation">{route.get("explanation", "")}</p><dl className="route-facts"><div><dt>Estimated total</dt><dd>{money(cash.get("total_cost_lkr"))}</dd></div><div><dt>Duration</dt><dd>{"Not confirmed" if route.get("duration_months") is None else str(route["duration_months"]) + " months"}</dd></div><div><dt>Initial savings gap</dt><dd>{money(cash.get("shortfall_lkr"))}</dd></div></dl>
    <ol className="stage-list">{for step in rows(route, "steps") { <li key={step["id"]}><strong>{step["title"]}</strong><span>{step["institution"]}</span><small>{label_for(step.get("delivery_mode", "unknown")) + " · " + str(step.get("campus", "Campus to confirm"))}</small>{if step.get("admission_scope") == "prior_qualification_required" { <p className="notice">{"Later entry: " + str(step.get("required_prior_qualification", "A prior qualification is required; this is not direct A/L entry."))}</p> }}</li> }}</ol>
    {if len(strings(route, "conditions")) > 0 { <div className="route-conditions"><h4>Conditions to meet</h4><ul>{for condition in strings(route, "conditions") { <li key={condition}>{condition}</li> }}</ul></div> }}{if len(strings(route, "unknowns")) > 0 { <p className="notice">{"Still to confirm: " + ", ".join([label_for(item) for item in route["unknowns"]]) + "."}</p> }}<Evidence claims={rows(route, "claims")} /><details className="next-actions"><summary>What to do next</summary><ol>{for action in strings(route, "next_actions") { <li key={action}>{action}</li> }}</ol></details></article>;
}
def:pub App() -> JsxElement {
    has form: dict = {"domain_id": "business", "career_goal": "", "al_stream": "unknown", "al_passes": "unknown", "al_year": "", "subject1": "", "grade1": "unknown", "subject2": "", "grade2": "unknown", "subject3": "", "grade3": "unknown", "ol_maths_grade": "unknown", "ol_english_grade": "unknown", "has_maths_credit": "unknown", "z_score": "", "savings_lkr": "2000", "monthly_budget_lkr": "5000", "home_district": "Galle", "study_mode": "any", "can_relocate": "unknown", "preference": "lowest_cost", "catalogue_mode": "real", "enable_ai": True, "existing_qualifications": []};
    has info: dict = {};
    has result: dict = {};
    has stress: dict = {};
    has submitted: dict = {};
    has loading: bool = False;
    has stressing: bool = False;
    has stale: bool = False;
    has error: str = "";
    has info_error: str = "";
    has stress_error: str = "";
    has dark: bool = False;
    has view: str = "routes";
    has revision: Ref[int] = Ref(0);
    has resultRef: Ref[HTMLDivElement] = Ref();
    grades = [["unknown", "Not supplied"], ["A", "A"], ["B", "B"], ["C", "C"], ["S", "S"], ["F", "F"]];
    streams = [["unknown", "Not supplied"], ["commerce", "Commerce"], ["physical_science", "Physical science"], ["biological_science", "Biological science"], ["arts", "Arts"], ["technology", "Technology"], ["other", "Other"]];
    yes_no = [["unknown", "Not sure yet"], ["yes", "Yes"], ["no", "No"]];
    async def load_info() -> None {
        info_error = "";
        try { response = root spawn get_app_info(); if response.reports and len(response.reports) > 0 { info = response.reports[0] as dict; } else { info_error = "The catalogue did not load. Try again."; } }
        except Exception { info_error = "We could not connect to the catalogue. Check your connection and try again."; }
    }
    async can with entry { await load_info(); }
    def change(e: ChangeEvent) -> None {
        name = e.target.name;
        value: any = e.target.value;
        if name == "enable_ai" { value = e.target.checked; }
        if name == "catalogue_mode" { value = "demo" if e.target.checked else "real"; form = {**form, "catalogue_mode": value, "existing_qualifications": [], "domain_id": "it" if value == "demo" else "business"}; }
        elif name == "qualification" { qualifications = form["existing_qualifications"]; form = {**form, "existing_qualifications": qualifications + [value] if e.target.checked else [q for q in qualifications if q != value]}; }
        else { form = {**form, name: value}; }
        revision.current = revision.current + 1; stale = len(result) > 0; loading = False; stressing = False; stress = {}; error = "";
    }
    def toggle_theme(e: MouseEvent) -> None { dark = not dark; }
    def routes_tab(e: MouseEvent) -> None { view = "routes"; }
    def graph_tab(e: MouseEvent) -> None { view = "graph"; }
    def activity_tab(e: MouseEvent) -> None { view = "activity"; }
    def payload() -> dict {
        subjects = [];
        for number in ["1", "2", "3"] { if form["subject" + number].strip() { subjects = subjects + [{"name": form["subject" + number].strip(), "grade": form["grade" + number]}]; } }
        return {"domain_id": form["domain_id"], "career_goal": form["career_goal"], "catalogue_mode": form["catalogue_mode"], "al_stream": form["al_stream"], "al_year": int(form["al_year"]) if form["al_year"] else None, "al_passes": None if form["al_passes"] == "unknown" else int(form["al_passes"]), "al_subjects": subjects, "ol_maths_grade": form["ol_maths_grade"], "ol_english_grade": form["ol_english_grade"], "has_maths_credit": None if form["has_maths_credit"] == "unknown" else form["has_maths_credit"] == "yes", "z_score": float(str(form["z_score"])) if form["z_score"] else None, "savings_lkr": int(form["savings_lkr"]), "monthly_budget_lkr": int(form["monthly_budget_lkr"]), "home_district": form["home_district"], "can_relocate": None if form["can_relocate"] == "unknown" else form["can_relocate"] == "yes", "study_mode": form["study_mode"], "existing_qualifications": form["existing_qualifications"], "preference": form["preference"], "enable_ai": form["enable_ai"], "profile_revision": revision.current};
    }
    async def plan() -> None {
        if loading { return; }
        error = "";
        if form["savings_lkr"] == "" or form["monthly_budget_lkr"] == "" { error = "Enter savings and monthly budget in whole rupees. Use 0 if none is available."; return; }
        if float(str(form["savings_lkr"])) < 0 or float(str(form["monthly_budget_lkr"])) < 0 or float(str(form["savings_lkr"])) != int(form["savings_lkr"]) or float(str(form["monthly_budget_lkr"])) != int(form["monthly_budget_lkr"]) { error = "Savings and monthly budget must be non-negative whole rupees."; return; }
        revision.current = revision.current + 1; ticket = revision.current; profile = payload(); loading = True; stress = {};
        try {
            response = root spawn plan_pathways(profile=profile);
            if ticket != revision.current { return; }
            if not response.reports or len(response.reports) == 0 { error = "No result was received. Your profile is kept here; try again."; }
            elif response.reports[0].get("status") == "invalid_input" { error = str(response.reports[0].get("message", "Check your profile and try again.")); }
            else { result = response.reports[0] as dict; submitted = profile; stale = False; view = "routes"; if resultRef.current { resultRef.current.focus(); } }
        } except Exception { if ticket == revision.current { error = "We could not finish your request. Check your connection, then try again. Your profile has been kept."; } }
        finally { if ticket == revision.current { loading = False; } }
    }
    async def submit(e: FormEvent) -> None { e.preventDefault(); await plan(); }
    async def test_budget() -> None {
        if stale or stressing or len(submitted) == 0 { return; }
        ticket = revision.current; stressing = True; stress_error = "";
        try {
            response = root spawn run_stress_test(profile=submitted, scenario="travel_plus_40_and_delay_6m");
            if ticket == revision.current { if response.reports and len(response.reports) > 0 and response.reports[0].get("status") == "ready" { stress = response.reports[0] as dict; } else { stress_error = "The scenario could not be calculated. Try again."; } }
        } except Exception { if ticket == revision.current { stress_error = "The scenario request failed. Your results are still available. Try again."; } }
        finally { if ticket == revision.current { stressing = False; } }
    }
    domains = [[d["id"], d["label"]] for d in info.get("domains", [])];
    if form["catalogue_mode"] == "demo" { domains = [["it", "IT & Computing · demo fixtures"]]; }
    quals: list[dict] = rows(info, "demo_qualifications") if form["catalogue_mode"] == "demo" else rows(info, "real_qualifications");
    question = result.get("pending_question"); projection = result.get("graph_projection", {}) as dict; nodes = rows(projection, "nodes"); edges = rows(projection, "edges");
    return <div className={"unipath dark" if dark else "unipath"}><a className="skip-link" href="#profile">Skip to your profile</a><header className="site-header"><a className="brand" href="#"><span className="brand-mark" aria-hidden="true">U</span><span>UniPath <span className="brand-lk">LK</span></span></a><div className="header-right"><span className="country-label">Education pathways in Sri Lanka</span><button type="button" className="quiet-button theme-button" onClick={toggle_theme} aria-pressed={dark}>{"Light theme" if dark else "Dark theme"}</button></div></header>
    <main className="page-shell"><section className="intro"><div><p className="eyebrow">Your next step after A/Ls</p><h1>A route that fits<br />your real life.</h1><p className="intro-copy">Explore study options across Sri Lanka, with your qualifications, budget and circumstances in view.</p></div><aside className="intro-aside"><span className="fine-rule"></span><p>Start with what you know.<br />We will make the gaps clear.</p><a href="#how-it-works">How your results are checked ↓</a></aside></section>
    <div className="workspace"><section className="profile-panel" id="profile"><div className="section-heading"><span className="section-number">01</span><div><h2>Your starting point</h2><p>Unknown details can be added later.</p></div></div>{if info_error { <div className="error" role="alert"><p>{info_error}</p><button type="button" className="quiet-button" onClick={load_info}>Retry catalogue</button></div> }}
    <form onSubmit={submit}><fieldset><legend>Where would you like to go?</legend><SelectField name="domain_id" label="Field of interest" value={form["domain_id"]} options={domains} onChange={change} /><TextField name="career_goal" label="Your goal (optional)" value={form["career_goal"]} onChange={change} hint="For example, work in accounting or build a tourism business." /><div className="two-col"><SelectField name="al_stream" label="A/L stream" value={form["al_stream"]} options={streams} onChange={change} /><SelectField name="al_passes" label="A/L subject passes" value={form["al_passes"]} options={[["unknown", "Not supplied"], ["0", "0 passes"], ["1", "1 pass"], ["2", "2 passes"], ["3", "3 passes"]]} onChange={change} /></div></fieldset>
    <fieldset><legend>What can you put towards study?</legend><div className="two-col"><TextField name="savings_lkr" label="Available savings (LKR)" value={form["savings_lkr"]} kind="number" onChange={change} /><TextField name="monthly_budget_lkr" label="Monthly budget (LKR)" value={form["monthly_budget_lkr"]} kind="number" onChange={change} /></div><p className="field-note">Use money available for education. Unconfirmed course costs stay visible as unknown.</p></fieldset>
    <details className="profile-details"><summary>Subjects, grades & qualifications<span>Optional, useful for entry checks</span></summary><div className="details-body"><TextField name="al_year" label="A/L examination year" value={form["al_year"]} kind="number" minimum="2000" maximum="2030" onChange={change} hint="2000–2030, or leave blank." />{for number in ["1", "2", "3"] { <div key={number} className="subject-row"><TextField name={"subject" + number} label={"A/L subject " + number} value={form["subject" + number]} onChange={change} maxLength={80} /><SelectField name={"grade" + number} label="Grade" value={form["grade" + number]} options={grades} onChange={change} /></div> }}<div className="two-col"><SelectField name="ol_maths_grade" label="O/L Mathematics" value={form["ol_maths_grade"]} options={grades} onChange={change} /><SelectField name="ol_english_grade" label="O/L English" value={form["ol_english_grade"]} options={grades} onChange={change} /></div><SelectField name="has_maths_credit" label="O/L Mathematics credit (if grade unknown)" value={form["has_maths_credit"]} options={yes_no} onChange={change} /><TextField name="z_score" label="Z-score (optional)" value={form["z_score"]} kind="number" minimum="-5" maximum="5" stepValue="any" onChange={change} hint="Use a number between −5 and 5, or leave blank." /><details className="qualifications"><summary>Qualifications already completed</summary><p className="muted">Select only awards you have already earned.</p><div className="qualification-list">{for qual in quals { <label key={qual["id"]} className="check-row"><input type="checkbox" name="qualification" value={qual["id"]} checked={qual["id"] in form["existing_qualifications"]} onChange={change} /><span>{qual["label"]}</span></label> }}</div></details></div></details>
    <details className="profile-details"><summary>Location & study preferences<span>Travel, mode and priorities</span></summary><div className="details-body"><TextField name="home_district" label="Home district" value={form["home_district"]} onChange={change} maxLength={60} /><SelectField name="can_relocate" label="Can you relocate or travel to campus?" value={form["can_relocate"]} options={yes_no} onChange={change} /><SelectField name="study_mode" label="Preferred study mode" value={form["study_mode"]} options={[["any", "Any study mode"], ["full_time", "Full time"], ["part_time", "Part time"], ["distance", "Distance learning"], ["blended", "Blended learning"]]} onChange={change} /><SelectField name="preference" label="Prioritise routes by" value={form["preference"]} options={[["lowest_cost", "Lowest confirmed cost"], ["shortest_duration", "Shortest confirmed duration"], ["study_fit", "Study fit"]]} onChange={change} /></div></details>
    <div className="planning-options"><label className="check-row"><input type="checkbox" name="enable_ai" checked={form["enable_ai"]} onChange={change} /><span>Use AI planning assistance<small>Entry rules and costs are always checked by server rules.</small></span></label><details className="demo-options"><summary>Demonstration settings</summary><label className="check-row"><input type="checkbox" name="catalogue_mode" checked={form["catalogue_mode"] == "demo"} onChange={change} /><span>Use fictional demo fixtures<small>For testing only. These are not real programme offers.</small></span></label></details></div>{if form["catalogue_mode"] == "demo" { <p className="notice">Demo catalogue active. All route data is fictional.</p> }}{if error { <div className="error" role="alert">{error}</div> }}<button className="primary-button" type="submit" disabled={loading or len(info) == 0}>{"Checking your pathways…" if loading else ("Update my pathways" if len(result) > 0 else "Explore my pathways")}<span aria-hidden="true">→</span></button><p className="privacy-note">No account needed. Your profile is not saved by this planner.</p></form></section>
    <section className="results-panel" aria-busy={loading}><div className="section-heading" ref={resultRef} tabIndex={-1}><span className="section-number">02</span><div><h2>Your possible pathways</h2><p>{"Based on your submitted profile" if len(result) > 0 else "A clearer view of what comes next"}</p></div></div><div className="live-status" role="status" aria-live="polite">{if loading { <p>Checking entry rules, progression and costs. This may take a few seconds.</p> } elif stale { <p className="notice">Your profile has changed. Update your pathways to use these details.</p> }}</div>
    {if len(result) == 0 { <div className="empty-state"><div className="path-illustration" aria-hidden="true"><span></span><i></i><span></span><i></i><span></span></div><h3>Every starting point has possibilities.</h3><p>Tell us a little about yours. We will show up to three routes, the conditions to meet, and what still needs checking.</p><ul className="expectations"><li><span>01</span>Match your selected field</li><li><span>02</span>Check the whole study route</li><li><span>03</span>See the evidence behind each claim</li></ul></div> } else {
    <div><div className="results-context"><span className="status">{"Fictional demo data" if result.get("catalogue_mode") == "demo" else "Real programme catalogue"}</span><small>{"Version " + str(result.get("catalogue_version", ""))}</small></div>
    {if question { <section className="question-panel"><h3>One detail could help</h3><p>{question["prompt"]}</p><small>{question["reason"]}</small><div className="question-answer">{if question["field"] == "al_passes" { <SelectField name="al_passes" idSuffix="-answer" label="Your A/L passes" value={form["al_passes"]} options={[["unknown", "Not supplied"], ["0", "0"], ["1", "1"], ["2", "2"], ["3", "3"]]} onChange={change} /> } elif question["field"] == "al_stream" { <SelectField name="al_stream" idSuffix="-answer" label="Your A/L stream" value={form["al_stream"]} options={streams} onChange={change} /> } elif question["field"] in ["ol_maths_grade", "ol_english_grade"] { <SelectField name={question["field"]} idSuffix="-answer" label="Your O/L grade" value={form[question["field"]]} options={grades} onChange={change} /> } else { <SelectField name={question["field"]} idSuffix="-answer" label="Your answer" value={form.get(question["field"], "unknown")} options={yes_no} onChange={change} /> }}</div><button type="button" className="secondary-button" onClick={plan} disabled={loading}>{"Checking…" if loading else "Update my pathways"}</button></section> }}
    <nav className="view-tabs" aria-label="Result views"><button type="button" aria-pressed={view == "routes"} onClick={routes_tab}>Pathways</button><button type="button" aria-pressed={view == "graph"} onClick={graph_tab}>Catalogue connections</button><button type="button" aria-pressed={view == "activity"} onClick={activity_tab}>Planning activity</button></nav>
    {if view == "routes" { <div>{if len(rows(result, "candidates")) == 0 { <div className="no-results"><h3>No route fits the current information.</h3><p>Review the entry conditions below, or try a different study mode or field. Missing catalogue coverage does not mean no real pathway exists.</p></div> }}{for (index, route) in enumerate(rows(result, "candidates")) { <RouteView key={route["route_id"]} route={route} index={index} /> }}{if len(rows(result, "blocked_candidates")) > 0 or len(rows(result, "blocked_transitions")) > 0 { <details className="blocked"><summary>Routes that do not fit your current inputs</summary>{for route in rows(result, "blocked_candidates") { <RouteView key={route["route_id"]} route={route} index={0} /> }}<ul>{for (index, blocked) in enumerate(rows(result, "blocked_transitions")) { <li key={str(index)}><strong>{blocked["title"]}</strong><p>{blocked["reason"]}</p></li> }}</ul></details> }}
    <section className="stress-section"><h3>Give your budget a little room</h3><p>See a scenario with travel costs 40% higher and a six-month delay to the first stage. This is a scenario, not a forecast.</p><button type="button" className="secondary-button" disabled={stale or stressing} onClick={test_budget}>{"Calculating scenario…" if stressing else "Test this budget scenario"}</button>{if stale { <small>Update your pathways before testing this scenario.</small> }}{if stress_error { <p className="error" role="alert">{stress_error}</p> }}{if len(stress) > 0 { <div className="stress-results" aria-live="polite">{if len(rows(stress, "deltas")) == 0 { <p>No candidate routes are available for this scenario.</p> }}{for delta in rows(stress, "deltas") { <div key={delta["route_id"]}><h4>{delta["title"]}</h4>{if delta["available"] { <dl className="route-facts"><div><dt>Additional cost</dt><dd>{money(delta.get("delta_total_cost_lkr"))}</dd></div><div><dt>Additional savings gap</dt><dd>{money(delta.get("delta_shortfall_lkr"))}</dd></div><div><dt>Additional time</dt><dd>{str(delta["delta_duration_months"]) + " months"}</dd></div></dl> } else { <p className="notice">{"Incomplete — " + str(delta["reason"])}</p> }}</div> }}</div> }}</section></div>
    } elif view == "graph" { <section className="graph-view"><h3>What the catalogue connects</h3><p className="muted">These are the actual programme nodes and progression links considered for this field. A connection still needs its stated entry conditions.</p><ol className="graph-nodes">{for node in nodes { <li key={node["id"]}><div className="row spread"><h4>{node["title"]}</h4><span className={"status " + str(node["evidence_status"])}>{label_for(node["evidence_status"])}</span></div><p>{node["institution"]}</p><ul>{for finding in rows(node, "findings") { <li key={finding["lens"]}><strong>{str(finding["lens"]) + ": "}</strong>{finding["summary"]}</li> }}</ul></li> }}</ol><h4>Progression links</h4>{if len(edges) == 0 { <p>No progression links are recorded for this field. The programmes above are independent entry points.</p> } else { <ul className="edge-list">{for (index, edge) in enumerate(edges) { <li key={str(index)}><span>{" → ".join([n["title"] for nid in [edge["from"], edge["to"]] for n in nodes if n["id"] == nid])}</span><small>{"Evidence: " + label_for(edge["evidence_status"])}</small></li> }}</ul> }}</section>
    } else { <section className="activity-view"><h3>How this plan was checked</h3><p className="muted">{"AI-assisted planning with server rule checks." if result.get("planner_mode") == "live_ai" else ("AI and rule-based planning with server rule checks." if result.get("planner_mode") == "mixed" else "Rule-based planning with server rule checks.")}</p>{if result.get("fallback_reason") { <p className="notice">{result["fallback_reason"]}</p> }}<ol className="activity-list">{for event in rows(result, "decision_events") { <li key={str(event.get("step", ""))}><strong>{label_for(event["action"])}</strong><p>{event["detail"]}</p></li> }}</ol>{if result.get("search_truncated") { <p className="notice">The bounded catalogue search reached its limit. Further routes may exist.</p> }}</section> }}<p className="coverage-note">{result.get("coverage_note", "")}</p><p className="coverage-note">{result.get("goal_note", "")}</p></div> }}</section></div>
    <section className="method-note" id="how-it-works"><h2>A starting point for a real conversation.</h2><div><p>UniPath LK searches a small education catalogue and checks the rules across each route. AI can help choose the next planning step; it cannot change programme facts or guarantee admission.</p><p>Confirm current entry rules, fees, professional recognition and intakes with the institution before you commit. Your results show the sources and the information still missing.</p></div></section></main><footer className="site-footer"><span>UniPath LK</span><p>Thoughtful next steps. Clearer decisions.</p><a href="#profile">Back to your profile ↑</a></footer></div>;
}




